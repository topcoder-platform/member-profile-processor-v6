# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ratings_db

# Application Configuration
LOG_LEVEL=debug
PORT=3000
NODE_ENV=development

# Kafka Configuration
KAFKA_URL=localhost:9092
KAFKA_GROUP_ID=member-profile-processor-group-consumer

# Kafka Topics
KAFKA_AUTOPILOT_NOTIFICATIONS_TOPIC=notifications.autopilot.events
KAFKA_RATING_SERVICE_TOPIC=notification.rating.calculation

# Auth0 OAuth Configuration (Mock for development)
AUTH0_URL=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=mock-client-id
AUTH0_CLIENT_SECRET=mock-client-secret

# API Endpoints (Point to mock server)
V5_API_URL=http://localhost:3001
